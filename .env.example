# StockItEase Frontend Environment Variables
# Copy this file to .env or .env.local for local Vite development
# Never commit real credentials or production keys to version control

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase Anon Public Key (safe for client-side browser usage)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
